# Cobalt Backend Configuration Example
# Copy this file to .env and configure the values for your environment.

# Base path for storing uploaded files
STORAGE_BASE_PATH=/Users/yourusername/cloud_storage

# Secret key for signing JWT tokens (should be at least 32 characters long in production)
JWT_SECRET=super-secret-change-in-production-32-chars-min

# 32-byte key for encryption/decryption (AES-GCM)
ENCRYPTION_KEY=32-byte-secret-key-for-aes-gcm-123456

# Database connection URL
DATABASE_URL=sqlite://cobalt.db?mode=rwc

# Port on which the backend server will run
SERVER_PORT=8001
